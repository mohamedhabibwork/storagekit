{
  "name": "@mohamedhabibwork/storagekit",
  "version": "0.3.0",
  "description": "Unified TypeScript file-management API across Local, S3, MinIO, Azure Blob and Oracle OCI Object Storage — with strongly-typed native provider options.",
  "license": "MIT",
  "author": "Mohamed Habib <mohamedhabibwork@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamedhabibwork/storagekit.git"
  },
  "homepage": "https://github.com/mohamedhabibwork/storagekit#readme",
  "bugs": "https://github.com/mohamedhabibwork/storagekit/issues",
  "keywords": [
    "storage",
    "file",
    "upload",
    "download",
    "s3",
    "aws",
    "minio",
    "azure",
    "blob",
    "oracle",
    "oci",
    "rustfs",
    "gcs",
    "google-cloud-storage",
    "filesystem",
    "storage-driver",
    "multipart",
    "multer",
    "formidable",
    "fastify",
    "hono",
    "express",
    "nestjs",
    "file-upload",
    "presigned-url",
    "sas",
    "s3-compatible",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./local": {
      "types": "./dist/drivers/local/index.d.ts",
      "import": "./dist/drivers/local/index.js",
      "require": "./dist/drivers/local/index.cjs"
    },
    "./s3": {
      "types": "./dist/drivers/s3/index.d.ts",
      "import": "./dist/drivers/s3/index.js",
      "require": "./dist/drivers/s3/index.cjs"
    },
    "./minio": {
      "types": "./dist/drivers/minio/index.d.ts",
      "import": "./dist/drivers/minio/index.js",
      "require": "./dist/drivers/minio/index.cjs"
    },
    "./azure": {
      "types": "./dist/drivers/azure/index.d.ts",
      "import": "./dist/drivers/azure/index.js",
      "require": "./dist/drivers/azure/index.cjs"
    },
    "./oracle": {
      "types": "./dist/drivers/oracle/index.d.ts",
      "import": "./dist/drivers/oracle/index.js",
      "require": "./dist/drivers/oracle/index.cjs"
    },
    "./rustfs": {
      "types": "./dist/drivers/rustfs/index.d.ts",
      "import": "./dist/drivers/rustfs/index.js",
      "require": "./dist/drivers/rustfs/index.cjs"
    },
    "./gcs": {
      "types": "./dist/drivers/gcs/index.d.ts",
      "import": "./dist/drivers/gcs/index.js",
      "require": "./dist/drivers/gcs/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/driver-contract.d.ts",
      "import": "./dist/testing/driver-contract.js",
      "require": "./dist/testing/driver-contract.cjs"
    },
    "./uploads": {
      "types": "./dist/uploads/index.d.ts",
      "import": "./dist/uploads/index.js",
      "require": "./dist/uploads/index.cjs"
    },
    "./adapters/express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js",
      "require": "./dist/adapters/express.cjs"
    },
    "./adapters/fastify": {
      "types": "./dist/adapters/fastify.d.ts",
      "import": "./dist/adapters/fastify.js",
      "require": "./dist/adapters/fastify.cjs"
    },
    "./adapters/formidable": {
      "types": "./dist/adapters/formidable.d.ts",
      "import": "./dist/adapters/formidable.js",
      "require": "./dist/adapters/formidable.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt",
    "docs"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/fix-dts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:types": "vitest run --typecheck.only",
    "test:watch": "vitest",
    "test:integration:cloud": "vitest run tests/integrations",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test:runtime": "npm run build && node scripts/runtime-smoke.mjs"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": ">=3.400.0",
    "@aws-sdk/lib-storage": ">=3.400.0",
    "@aws-sdk/s3-request-presigner": ">=3.400.0",
    "@azure/storage-blob": ">=12.17.0",
    "@fastify/multipart": ">=8.0.0",
    "@google-cloud/storage": ">=7.0.0",
    "formidable": ">=2.0.0",
    "hono": ">=4.0.0",
    "minio": ">=7.1.0",
    "multer": ">=1.4.4",
    "oci-common": ">=2.0.0",
    "oci-objectstorage": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/lib-storage": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "@azure/storage-blob": {
      "optional": true
    },
    "@fastify/multipart": {
      "optional": true
    },
    "@google-cloud/storage": {
      "optional": true
    },
    "formidable": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "minio": {
      "optional": true
    },
    "multer": {
      "optional": true
    },
    "oci-common": {
      "optional": true
    },
    "oci-objectstorage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@azure/storage-blob": "^12.26.0",
    "@fastify/multipart": "^10.1.1",
    "@google-cloud/storage": "^7.22.0",
    "@types/express": "^5.0.6",
    "@types/formidable": "^3.5.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "express": "^5.2.1",
    "fastify": "^5.12.3",
    "formidable": "^3.5.4",
    "hono": "^4.13.5",
    "minio": "^8.0.2",
    "multer": "^2.3.0",
    "oci-common": "^2.107.0",
    "oci-objectstorage": "^2.107.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "decode-uri-component": "^0.5.0",
    "esbuild": "^0.28.1",
    "stream-json": "^3.5.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
